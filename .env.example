# Copy to .env to override defaults. Every value below is optional.

# TCP port players connect to (published on the host AND used inside the container).
LINUXQUEST_PORT=2222

# Host interface to publish on. 0.0.0.0 = all interfaces, 127.0.0.1 = this machine only.
LINUXQUEST_BIND=0.0.0.0

# Concurrent sessions allowed before new players are told the server is full.
LINUXQUEST_MAX_SESSIONS=100

# Disconnect players after this many idle minutes / total minutes (0 disables).
LINUXQUEST_IDLE_TIMEOUT_MIN=15
LINUXQUEST_MAX_SESSION_MIN=120

# Comma-separated usernames that become admins (server stats via the
# `admin` command). The very first registered account is admin either way.
LINUXQUEST_ADMINS=

# Login-help web page port (key setup instructions). 0 disables it.
LINUXQUEST_WEB_PORT=8080

# --- Running the binary directly (no Docker) -------------------------------
# LINUXQUEST_HOST=0.0.0.0
# LINUXQUEST_HOST_KEY=data/ssh_host_ed25519
# LINUXQUEST_DB=data/linuxquest.db
